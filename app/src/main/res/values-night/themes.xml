<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Material 3, DayNight, custom palette following 60-30-10 rule.
         60% neutral surfaces, 30% secondary, 10% primary accent. Google Font: Poppins. -->
    <style name="Theme.Todolist" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/poppins_regular</item>

        <!-- 10% primary accent -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- 30% secondary -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <!-- 60% neutral -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/priority_high</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Widget.Todolist.LoadingOverlay" parent="">
        <item name="android:background">@color/scrim</item>
    </style>
</resources>